# Copia este ficheiro para .env e preenche os valores reais.
# .env nunca é commitado (está no .gitignore).

# ---- Base de dados (PostgreSQL) ----
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
# Opcional — assume 5432 (porta padrão do Postgres) se não for definida.
DB_PORT=
DB_SYNC=
DB_ALTER=

# ---- Autenticação ----
JWT_SECRET=
FRONTEND_URL=
# Origens extra permitidas por CORS além de FRONTEND_URL, separadas por vírgula
# (ex.: um domínio de staging). Opcional.
CORS_EXTRA_ORIGINS=

# ---- Email (Resend) ----
# Usado para: OTP de verificação, reset de password (utils/emailService.js)
# e notificações de negócio em nome de cada empresa (services/notificacaoExterna.service.js).
# Sem RESEND_API_KEY, tudo cai para log em consola (modo desenvolvimento).
RESEND_API_KEY=
# Endereço técnico de envio (o domínio tem de estar verificado no Resend).
# O nome que aparece antes do endereço muda consoante o email: "Vale do
# Zambeze <...>" para OTP/reset, "<Nome da Empresa> <...>" para notificações.
RESEND_FROM_EMAIL=notificacoes@valedozambeze.com

# ---- SMS (Africa's Talking) ----
# Usado para notificações de negócio (aprovação, alertas de prazo/pagamento)
# em services/notificacaoExterna.service.js. Sem estas chaves, cai para
# log em consola.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# Sender ID partilhado da plataforma (registo único, ~35 USD, feito uma
# vez no dashboard da Africa's Talking — não é por empresa/tenant).
AFRICASTALKING_SENDER_ID=

# Força o modo consola (dev) para emails/SMS mesmo com NODE_ENV=production
# — útil para testar em staging sem gastar SMS/email reais.
SKIP_EMAIL_VERIFICATION=false

NODE_ENV=development
