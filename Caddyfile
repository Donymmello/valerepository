# REFERÊNCIA, não é usado pelo docker-compose.yml deste repo.
#
# A VPS de produção já tem um Caddy partilhado a servir outros projetos
# (vektra-site, kuava-pos), preso às portas 80/443 do host. Por isso o
# Tshemba não sobe o seu próprio Caddy, em vez disso os containers
# api_backend/web_frontend ligam-se à rede Docker externa "web" (ver
# docker-compose.yml) e este bloco é acrescentado ao Caddyfile REAL, que
# fica em /opt/vektra-site/Caddyfile na VPS (fora deste repo).
#
# tshemba.vektarmz.com {
#     handle /api/* {
#         reverse_proxy meu_backend:5000
#     }
#
#     handle {
#         reverse_proxy frontend:80
#     }
# }
#
# Depois de editar o Caddyfile real na VPS:
#   docker exec vektra-site-caddy-1 caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
